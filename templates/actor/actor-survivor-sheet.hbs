<form class="{{cssClass}} {{actor.type}} flexcol" autocomplete="off">

  {{!-- Sheet Header --}}
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" height="100" width="100"/>
    <div class="header-fields">
      <h1 class="charname">
        <input name="name" type="text" value="{{actor.name}}" placeholder="Name"/>
      </h1>
      <div class="resources grid grid-4col">

        {{!-- Max is derived from Muscles + Tripes — read-only --}}
        <div class="resource flex-group-center">
          <label class="resource-label">{{localize "ZOMBICIDE.Resource.Health"}}</label>
          <div class="resource-content flexrow flex-center flex-between">
            <input type="text" name="system.health.value" value="{{system.health.value}}" data-dtype="Number"/>
            <span>/</span>
            <span class="resource-max" title="{{localize 'ZOMBICIDE.Resource.HealthFormula'}}">{{system.health.max}}</span>
          </div>
        </div>

        {{!-- Max is derived from (Cerveau + Tripes) × 2 — read-only --}}
        <div class="resource flex-group-center">
          <label class="resource-label">{{localize "ZOMBICIDE.Resource.Stress"}}</label>
          <div class="resource-content flexrow flex-center flex-between">
            <input type="text" name="system.stress.value" value="{{system.stress.value}}" data-dtype="Number"/>
            <span>/</span>
            <span class="resource-max" title="{{localize 'ZOMBICIDE.Resource.StressFormula'}}">{{system.stress.max}}</span>
          </div>
        </div>

        <div class="resource flex-group-center">
          <label class="resource-label">{{localize "ZOMBICIDE.Resource.Experience"}}</label>
          <div class="resource-content flexrow flex-center flex-between">
            <input type="text" name="system.experience" value="{{system.experience}}" data-dtype="Number"/>
          </div>
        </div>

        {{!-- Danger level is derived from XP — read-only --}}
        <div class="resource flex-group-center danger-level danger-{{dangerLevel}}">
          <label class="resource-label">{{localize "ZOMBICIDE.Resource.Danger"}}</label>
          <div class="resource-content flexrow flex-center">
            <span class="danger-badge">{{dangerLevelLabel}}</span>
          </div>
        </div>

      </div>
    </div>
  </header>

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="skills">Skills</a>
    <a class="item" data-tab="weapons">Weapons</a>
    <a class="item" data-tab="equipment">Equipment</a>
    <a class="item" data-tab="description">Description</a>
    <a class="item" data-tab="effects">Effects</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Skills Tab --}}
    <div class="tab" data-group="primary" data-tab="skills">

      {{!-- Attributes (columns) × aptitudes (rows). Each cell is a derived
            action: its pool is the sum of the two stats it sits between. --}}
      <div class="action-grid">

        <div class="action-grid-row action-grid-head">
          <div class="action-grid-corner">{{localize "ZOMBICIDE.Label.Aptitudes"}}</div>
          {{#each attributeColumns as |col|}}
          <div class="action-grid-stat">
            <label for="attr-{{col.key}}">{{col.label}}</label>
            <input id="attr-{{col.key}}" type="text" name="system.attributes.{{col.key}}.value"
              value="{{col.value}}" data-dtype="Number"/>
          </div>
          {{/each}}
        </div>

        {{#each actionMatrix as |row|}}
        <div class="action-grid-row">
          <div class="action-grid-stat action-grid-aptitude">
            <label for="apt-{{row.key}}">{{row.label}}</label>
            <input id="apt-{{row.key}}" type="text" name="system.aptitudes.{{row.key}}.value"
              value="{{row.value}}" data-dtype="Number"/>
          </div>
          {{#each row.cells as |action|}}
          <a class="action-cell rollable" data-action="{{action.key}}"
            title="{{action.attributeLabel}} + {{action.aptitudeLabel}}">
            <span class="action-pool">{{action.pool}}</span>
            <span class="action-name">{{action.label}}</span>
          </a>
          {{/each}}
        </div>
        {{/each}}

      </div>

      {{> "systems/zombicide-chronicles/templates/actor/parts/actor-skills.hbs"}}
    </div>

    {{!-- Weapons Tab --}}
    <div class="tab" data-group="primary" data-tab="weapons">
      {{> "systems/zombicide-chronicles/templates/actor/parts/actor-weapons.hbs"}}
    </div>

    {{!-- Equipment Tab --}}
    <div class="tab" data-group="primary" data-tab="equipment">
      {{> "systems/zombicide-chronicles/templates/actor/parts/actor-equipment.hbs"}}
    </div>

    {{!-- Description Tab --}}
    <div class="tab biography" data-group="primary" data-tab="description">
      {{editor enrichedBiography target="system.biography" engine="prosemirror" button=true editable=editable}}
    </div>

    {{!-- Active Effects Tab --}}
    <div class="tab effects flexcol" data-group="primary" data-tab="effects">
      {{> "systems/zombicide-chronicles/templates/actor/parts/actor-effects.hbs"}}
    </div>

  </section>
</form>
